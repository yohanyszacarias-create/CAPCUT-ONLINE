# Usar Node estable y liviano
FROM node:20-alpine

# Crear carpeta de trabajo
WORKDIR /app

# Copiar manifiestos si existen (si no, igual sigue)
COPY package*.json ./

# Instalar deps (si no hay package.json no falles)
RUN if [ -f package.json ]; then \
      npm ci --omit=dev || npm install --only=production ; \
    else echo "No package.json, continuando..."; fi

# Copiar TODO el repo (sin asumir carpetas que no existen)
COPY . .

# Variables por defecto (Render puede sobreescribir en Environment)
ENV PORT=3000
EXPOSE 3000

# Arrancar el servidor (ajusta a tu archivo real)
# Si tu servidor es api.js, déjalo así. Si es server.js, cambia el nombre.
CMD ["node", "api.js"]
